{
  "version": 2,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/app.js",
      "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
    },
    {
      "source": "/index.html",
      "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
    },
    {
      "source": "/sw.js",
      "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
    }
  ],
  "routes": [{"src":"/(.*)","dest":"/$1"}]
}
